; Engine configuration file.
; RECONSTRUCTED from project.binary by reverse engineering (2026-07-23).
; NOTE: This is a best-effort reconstruction. Numeric values marked with
;       "# reconstructed" are inferred and may need adjustment to match the
;       original build exactly. Verify in the Godot 4.2 editor.

config_version=5

[application]

config/name="Nodebuster"
run/main_scene="res://MainScene.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"
config/windows_native_icon="res://Icon.ico"
boot_splash/show_image=false

[autoload]

Layers="*res://Scripts/Autoloads/Layers.gd"
Defer="*res://Scripts/Autoloads/Defer.gd"
Refs="*res://Scripts/Autoloads/Refs.gd"
Saver="*res://Scripts/Autoloads/Saver.gd"
UpgradeStore="*res://Scripts/Autoloads/Stores/UpgradeStore.gd"
MilestoneStore="*res://Scripts/Autoloads/Stores/MilestoneStore.gd"
Globals="*res://Scripts/Autoloads/Globals.gd"
Springer="*res://Scripts/Autoloads/Springer.gd"
Jumper="*res://Scripts/Autoloads/Jumper.gd"
Shaker="*res://Scripts/Autoloads/Shaker.gd"
MyTimer="*res://Scripts/Autoloads/Timer/MyTimer.gd"
ShapeCaster="*res://Scripts/Autoloads/ShapeCaster.gd"
Effects="*res://Scripts/Autoloads/Effects.gd"
State="*res://Scripts/Autoloads/State.gd"
SFX="*res://Scripts/Autoloads/SFX.gd"
BGM="*res://Scripts/Autoloads/BGM.gd"
OptionData="*res://Scripts/Autoloads/OptionData.gd"
RTLSizer="*res://Scripts/Autoloads/RTLSizer.gd"
MySteam="*res://Scripts/Autoloads/MySteam.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/resizable=false
window/size/window_width_override=1280   # reconstructed
window/size/window_height_override=720   # reconstructed
window/stretch/mode="viewport"           # reconstructed
window/stretch/scale_mode="integer"      # reconstructed

[editor_plugins]

enabled=PackedStringArray("res://addons/godotsteam/godotsteam.gdextension")

[input]

lmb={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
rmb={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
escape={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305)]
}
new_frame={
"deadzone": 0.5,
"events": []
}
left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65),Object(InputEventKey,"keycode":4194319)]
}
right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":68),Object(InputEventKey,"keycode":4194321)]
}
up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":87),Object(InputEventKey,"keycode":4194320)]
}
down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":83),Object(InputEventKey,"keycode":4194322)]
}

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0,0,0,1)
